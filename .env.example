# Development credentials only. Copy to .env; never commit .env.
DATABASE_NAME=tutormatch
DATABASE_USER=tutormatch
DATABASE_PASSWORD=tutormatch_dev
DATABASE_ROOT_PASSWORD=root_dev_only
DB_HOST=localhost
DB_PORT=3306
BACKEND_PORT=8080
FRONTEND_PORT=3000
# Leave empty until an AI provider is integrated. Backend only.
AI_API_KEY=

# Local HTTP only: false. Set true behind HTTPS in production.
COOKIE_SECURE=false
# Trusted backend webhook that delivers EMAIL or SMS messages. Required for registration/reset.
DELIVERY_URL=
DELIVERY_KEY=
# Optional chat-completions-compatible LLM endpoint; empty uses deterministic recommendations.
LLM_URL=
LLM_API_KEY=
LLM_MODEL=
# Deployment-only admin provisioning. Remove after first startup. Password >=16 characters.
ADMIN_EMAIL=
ADMIN_PASSWORD=
