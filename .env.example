# Development credentials only. Copy to .env; never commit .env.
DATABASE_NAME=tutormatch
DATABASE_USER=tutormatch
DATABASE_PASSWORD=tutormatch_dev
DATABASE_ROOT_PASSWORD=root_dev_only
DB_HOST=localhost
DB_PORT=3306
BACKEND_PORT=8080
FRONTEND_PORT=3000
# Local HTTP only: false. Set true behind HTTPS in production.
COOKIE_SECURE=false
# SMTP: Compose defaults to its local Mailpit inbox at http://localhost:8025.
# Native backend: MAIL_HOST=localhost. For an external SMTP server, configure its credentials/TLS.
APP_PUBLIC_URL=http://localhost:3000
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@tutormatch.local
MAIL_AUTH=false
MAIL_STARTTLS=false
MAIL_SSL=false
# Gmail SMTP: set MAIL_HOST=smtp.gmail.com, MAIL_PORT=587,
# MAIL_USERNAME and MAIL_FROM to your Gmail address, MAIL_AUTH=true,
# MAIL_STARTTLS=true, MAIL_SSL=false. Set MAIL_PASSWORD to a Google App Password.
# Setup and testing: docs/environment.md (Gmail SMTP).
MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PORT=1025
# AI deferred. Keep empty for deterministic rule-based recommendations.
LLM_URL=
LLM_API_KEY=
LLM_MODEL=
# Deployment-only admin provisioning. Remove after first startup. Password >=16 characters.
ADMIN_EMAIL=
ADMIN_PASSWORD=
